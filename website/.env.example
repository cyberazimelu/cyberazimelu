# Copy to .env.local for local development.
# Never commit real credentials.

HOSTINGER_MAILBOX_RESOURCE_ID=replace-with-hostinger-mailbox-resource-id
HOSTINGER_EMAIL_API_TOKEN=replace-with-hostinger-api-token

NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Comma-separated exact hostnames configured in Cloudflare Turnstile.
TURNSTILE_ALLOWED_HOSTNAMES=pmazimelutechnologies.com,www.pmazimelutechnologies.com